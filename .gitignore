# krkr2web 项目忽略规则
# 说明：
#   - build/        引擎 Wasm、产品壳与各阶段探针的构建产物，全部可重建，不提交。
#   - .toolchains/  锁定的 Emscripten SDK 等本地工具链，体积大、可重建，不提交。
#   - 参考资料/     开发用游戏资源与上游仓库克隆，不属于模拟器产品，不提交。
#   - diagnostic-reports/  实机报告运行数据，不提交（结论沉淀在 docs/）。
#   - certs/、*.pem、*.key   本地 HTTPS 测试证书与私钥，含私钥，绝不提交。

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.pytest-*

# Node
node_modules/
*.tsbuildinfo
test-results/
playwright-report/

# 运行数据与本地状态
/data/
diagnostic-reports/
port.txt
*.db
*.db-journal
*.db-wal
*.db-shm

# 环境变量与密钥
.env
.env.*
certs/
*.pem
*.key

# IDE 与编辑器
.vscode/
.idea/

# 操作系统
.DS_Store
Thumbs.db

# 构建产物
dist/
build/
.toolchains/
reference-captures/

# 压缩包
*.zip

# 本地开发资源与上游缓存
参考资料/

# 补丁与合并工具残留
*.orig
*.rej

# 日志与临时文件
*.log
.tmp/
test-tmp-*/

# 其他工具缓存
.claude/
.obsidian/
.playwright-mcp/
.superpowers/
.zcode/
