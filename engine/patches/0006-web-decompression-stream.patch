 #include <algorithm>
 
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+EM_ASYNC_JS(int, krkr2web_uncompress,
+	(unsigned char *destination, unsigned long *destination_length,
+	 const unsigned char *source, unsigned long source_length), {
+	var capacity = HEAPU32[destination_length >>> 2];
+	var trace = {
+		op: "xp3-decompress-worker",
+		detail: source_length + " -> " + capacity + " bytes",
+		startedAt: Date.now()
+	};
+	globalThis.krkr2webAsyncTrace = trace;
+	var worker = null;
+	var timer = 0;
+	try {
+		if (typeof Worker !== "function" || typeof Blob !== "function") {
+			throw new Error("Web Worker unavailable");
+		}
+		var input = HEAPU8.slice(source, source + source_length);
+		var workerCode = [
+			"self.onmessage = async function(event) {",
+			"  try {",
+			"    if (typeof DecompressionStream !== 'function') throw new Error('DecompressionStream unavailable');",
+			"    var stream = new Blob([event.data]).stream().pipeThrough(new DecompressionStream('deflate'));",
+			"    var output = await new Response(stream).arrayBuffer();",
+			"    self.postMessage({ output: output }, [output]);",
+			"  } catch (error) {",
+			"    self.postMessage({ error: error && error.message ? error.message : String(error) });",
+			"  }",
+			"};"
+		].join("\n");
+		var workerUrl = URL.createObjectURL(new Blob([workerCode], { type: "text/javascript" }));
+		try {
+			worker = new Worker(workerUrl);
+		} finally {
+			URL.revokeObjectURL(workerUrl);
+		}
+		if (source_length >= 1048576 && Module.print) {
+			Module.print("KRKR2WEB_XP3_WORKER_BEGIN input=" + source_length + " output=" + capacity);
+		}
+		var outputBuffer = await new Promise(function(resolve, reject) {
+			timer = setTimeout(function() {
+				reject(new Error("XP3 decompression worker timeout after 15000 ms"));
+			}, 15000);
+			worker.onmessage = function(event) {
+				if (event.data && event.data.error) {
+					reject(new Error(event.data.error));
+				} else if (event.data && event.data.output) {
+					resolve(event.data.output);
+				} else {
+					reject(new Error("XP3 decompression worker returned no output"));
+				}
+			};
+			worker.onerror = function(event) {
+				reject(new Error(event.message || "XP3 decompression worker failed"));
+			};
+			worker.postMessage(input.buffer, [input.buffer]);
+		});
+		var output = new Uint8Array(outputBuffer);
+		if (output.byteLength > capacity) return -5;
+		HEAPU8.set(output, destination);
+		HEAPU32[destination_length >>> 2] = output.byteLength;
+		if (source_length >= 1048576 && Module.print) {
+			Module.print("KRKR2WEB_XP3_WORKER_END input=" + source_length + " output=" + output.byteLength +
+				" elapsedMs=" + (Date.now() - trace.startedAt));
+		}
+		return 0;
+	} catch (error) {
+		if (Module.printErr) {
+			Module.printErr("KRKR2WEB_E_DECOMPRESSION_WORKER " +
+				(error && error.message ? error.message : String(error)));
+		}
+		return -3;
+	} finally {
+		if (timer) clearTimeout(timer);
+		if (worker) worker.terminate();
+		if (globalThis.krkr2webAsyncTrace === trace) globalThis.krkr2webAsyncTrace = null;
+	}
+});
+
+static int TVPXP3Uncompress(unsigned char *destination, unsigned long *destination_length,
+	const unsigned char *source, unsigned long source_length)
+{
+	return krkr2web_uncompress(destination, destination_length, source, source_length);
+}
+#else
+static int TVPXP3Uncompress(unsigned char *destination, unsigned long *destination_length,
+	const unsigned char *source, unsigned long source_length)
+{
+	return uncompress(destination, destination_length, source, source_length);
+}
+#endif
