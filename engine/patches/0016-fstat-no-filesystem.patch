-namespace fs = std::filesystem;
+struct FsEntry {
+    std::string name;
+    bool is_dir;
+    uint32_t mode;
+    uint64_t size;
+    uint64_t mtime;
+};
+
+inline bool fs_exists(const std::string &p) { return ::access(p.c_str(), F_OK) == 0; }
+inline bool fs_is_dir(const std::string &p) {
+    struct stat st;
+    return ::stat(p.c_str(), &st) == 0 && S_ISDIR(st.st_mode);
+}
+inline bool fs_is_regular(const std::string &p) {
+    struct stat st;
+    return ::stat(p.c_str(), &st) == 0 && S_ISREG(st.st_mode);
+}
+inline bool fs_create_dirs(const std::string &p) {
+    if (p.empty() || fs_exists(p)) return true;
+    size_t slash = p.find_last_of('/');
+    if (slash != std::string::npos) fs_create_dirs(p.substr(0, slash));
+    return ::mkdir(p.c_str(), 0755) == 0;
+}
+inline std::vector<FsEntry> fs_list_dir(const std::string &p) {
+    std::vector<FsEntry> out;
+    DIR *d = ::opendir(p.c_str());
+    if (!d) return out;
+    struct dirent *ent;
+    while ((ent = ::readdir(d)) != nullptr) {
+        FsEntry e;
+        e.name = ent->d_name;
+        std::string full = p + '/' + e.name;
+        struct stat st;
+        if (::stat(full.c_str(), &st) == 0) {
+            e.is_dir = S_ISDIR(st.st_mode);
+            e.mode = (uint32_t)st.st_mode;
+            e.size = (uint64_t)st.st_size;
+            e.mtime = (uint64_t)st.st_mtim.tv_sec;
+        } else {
+            e.is_dir = (ent->d_type == DT_DIR);
+            e.mode = 0;
+            e.size = 0;
+            e.mtime = 0;
+        }
+        out.push_back(e);
+    }
+    ::closedir(d);
+    return out;
+}
+
