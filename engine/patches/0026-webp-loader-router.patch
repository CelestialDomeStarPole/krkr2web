+++ b/external/krkrz/visual/GraphicsLoaderIntf.cpp
@@ -1644,10 +1644,22 @@
 #ifdef TVP_COMPILING_KRKRSDL2
-	if (!TVPLoadEmscriptenPreloadedData(handler->FormatData, (void*)&data, TVPLoadGraphic_SizeCallback,
-		TVPLoadGraphic_ScanLineCallback, TVPLoadGraphic_MetaInfoPushCallback,
-		name, keyidx, mode))
-	{
-		(handler->Load)(handler->FormatData, (void*)&data, TVPLoadGraphic_SizeCallback,
-			TVPLoadGraphic_ScanLineCallback, TVPLoadGraphic_MetaInfoPushCallback,
-			holder.Get(), keyidx, mode);
-	}
+	{
+		// krkr2web ADR-008: the game stores WebP with .png/.jpg/.tlg extensions.
+		uint8_t webp_header[16];
+		tjs_uint64 webp_pos = holder.Get()->GetPosition();
+		bool is_webp = (holder.Get()->Read(webp_header, 16) >= 12 &&
+			!memcmp(webp_header, "RIFF", 4) && !memcmp(webp_header + 8, "WEBPVP8", 7));
+		holder.Get()->SetPosition(webp_pos);
+		if (is_webp) {
+			TVPLoadWEBP(handler->FormatData, (void*)&data, TVPLoadGraphic_SizeCallback,
+				TVPLoadGraphic_ScanLineCallback, TVPLoadGraphic_MetaInfoPushCallback,
+				holder.Get(), keyidx, mode);
+		} else if (!TVPLoadEmscriptenPreloadedData(handler->FormatData, (void*)&data, TVPLoadGraphic_SizeCallback,
+			TVPLoadGraphic_ScanLineCallback, TVPLoadGraphic_MetaInfoPushCallback,
+			name, keyidx, mode))
+		{
+			(handler->Load)(handler->FormatData, (void*)&data, TVPLoadGraphic_SizeCallback,
+				TVPLoadGraphic_ScanLineCallback, TVPLoadGraphic_MetaInfoPushCallback,
+				holder.Get(), keyidx, mode);
+		}
+	}
 #endif
