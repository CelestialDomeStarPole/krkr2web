diff --git a/external/krkrz/visual/TransIntf.cpp b/external/krkrz/visual/TransIntf.cpp
--- a/external/krkrz/visual/TransIntf.cpp
+++ b/external/krkrz/visual/TransIntf.cpp
@@ -349,6 +349,18 @@ iTVPTransHandlerProvider * TVPFindTransHandlerProvider(const ttstr &name)
 
 	tTVPTransHandlerProviderHolder *holder =
 		TVPTransHandlerProviders.Find(name);
+#ifdef __EMSCRIPTEN__
+	// extrans depends on the unavailable RenderManager backend. Keep its known
+	// transition contracts usable by falling back to the built-in crossfade.
+	if(!holder && (name == TJS_W("wave") || name == TJS_W("mosaic") ||
+		name == TJS_W("turn") || name == TJS_W("rotatezoom") ||
+		name == TJS_W("rotatevanish") || name == TJS_W("rotateswap") ||
+		name == TJS_W("ripple")))
+	{
+		TVPAddImportantLog(ttstr(TJS_W("KRKR2WEB_D5_TRANS_FALLBACK ")) + name);
+		holder = TVPTransHandlerProviders.Find(TJS_W("crossfade"));
+	}
+#endif
 	if(!holder)
 		TVPThrowExceptionMessage(TVPCannotFindTransHander, name);
 
