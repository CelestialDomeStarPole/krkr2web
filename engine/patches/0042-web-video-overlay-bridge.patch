+#if defined(__EMSCRIPTEN__)
+#include <emscripten.h>
+// krkr2web: no in-wasm video decoder (the win32 path needs DirectShow via
+// krmovie). The host page owns a <video> overlay and plays a pre-transcoded
+// webm; all hooks are synchronous no-ops when the page does not define
+// them, preserving the previous skip-video behavior.
+EM_JS(void, krkr2webVideoOpen, (const char *name), {
+	if (globalThis.krkr2webVideoOpen) globalThis.krkr2webVideoOpen(UTF8ToString(name));
+});
+EM_JS(void, krkr2webVideoPlay, (), {
+	if (globalThis.krkr2webVideoPlay) globalThis.krkr2webVideoPlay();
+});
+EM_JS(void, krkr2webVideoStop, (), {
+	if (globalThis.krkr2webVideoStop) globalThis.krkr2webVideoStop();
+});
+EM_JS(void, krkr2webVideoPause, (int pause), {
+	if (globalThis.krkr2webVideoPause) globalThis.krkr2webVideoPause(pause);
+});
+
+tTJSNI_VideoOverlay *tTJSNI_VideoOverlay::WebVideoActiveOverlay = nullptr;
+
+void tTJSNI_VideoOverlay::NotifyWebVideoEnded()
+{
+	tTJSNI_VideoOverlay *overlay = WebVideoActiveOverlay;
+	if(!overlay) return;
+	// posts onStatusChanged("stop") through the normal event queue; looping
+	// videos never reach this (the host page restarts them instead).
+	overlay->SetStatus(tTVPVideoOverlayStatus::Stop);
+}
+#endif
