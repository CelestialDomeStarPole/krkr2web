+static void krkr2web_sync_savedata()
+{
+	MAIN_THREAD_ASYNC_EM_ASM({
+		FS.syncfs(false, function(error) {
+			if (error && Module.printErr) Module.printErr("IDBFS save sync failed: " + error);
+			Module._emscripten_syncfs_is_finished();
+		});
+	});
+}
+#else
 EM_JS(void, krkr2web_sync_savedata, (), {
 	FS.syncfs(false, function(error) {
 		if (error && Module.printErr) Module.printErr("IDBFS save sync failed: " + error);
 		_emscripten_syncfs_is_finished();
 	});
 });
+#endif
 #endif
