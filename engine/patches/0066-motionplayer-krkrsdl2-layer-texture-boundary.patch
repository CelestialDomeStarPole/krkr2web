+    iTVPTexture2D *SourceCache::textureFromLayerVariant(
+        const tTJSVariant &value) {
+        if(value.Type() != tvtObject || !value.AsObjectNoAddRef()) {
+            return nullptr;
+        }
+        auto *object = value.AsObjectNoAddRef();
+        auto *layer = resolveNativeLayer(object);
+        auto *image = layer ? layer->GetMainImage() : nullptr;
+        auto *bitmap = image ? image->GetBitmap() : nullptr;
+        if(!bitmap) {
+            return nullptr;
+        }
+
+        auto cached = _layerTextures.find(object);
+        if(cached != _layerTextures.end()) {
+            if(cached->second.bitmap == bitmap) {
+                return cached->second.texture;
+            }
+            cached->second.texture->Release();
+            _layerTextures.erase(cached);
+        }
+
+        auto *texture = TVPGetRenderManager()->CreateTexture2D(bitmap);
+        if(texture) {
+            _layerTextures.emplace(
+                object, LayerTextureCacheEntry{bitmap, texture});
+        }
+        return texture;
+    }
+
+    void SourceCache::eraseLayerTexture(const tTJSVariant &value) {
+        if(value.Type() != tvtObject || !value.AsObjectNoAddRef()) {
+            return;
+        }
+        const auto cached = _layerTextures.find(value.AsObjectNoAddRef());
+        if(cached == _layerTextures.end()) {
+            return;
+        }
+        cached->second.texture->Release();
+        _layerTextures.erase(cached);
+    }
