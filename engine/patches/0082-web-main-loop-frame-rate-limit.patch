+	// krkr2web (patch 0082): low-water probe for the main-loop frame gate.
+	bool AnyStreamRemainBelow(int threshold)
+	{
+		for (tTVPSoundBuffer *stream : _streams)
+		{
+			if (stream->IsPlaying() && stream->GetRemainBuffers() < threshold)
+			{
+				return true;
+			}
+		}
+		return false;
+	}
 };
 
