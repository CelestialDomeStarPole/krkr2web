+
+bool TVPWebAudioRemainBelow(int threshold)
+{
+#ifndef TVP_FAUDIO_IMPLEMENT
+	if (TVPAudioRenderer)
+	{
+		return TVPAudioRenderer->AnyStreamRemainBelow(threshold);
+	}
+#endif
+	return false;
+}
