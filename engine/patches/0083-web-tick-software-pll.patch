 //---------------------------------------------------------------------------
+// krkr2web (patch 0083): main-thread vsync phase-locked tick.
+// Ported from kirikiroid2-web cpp/core/environ/web/Platform.cpp. On Android
+// the engine main thread samples the tick clock from a Choreographer callback
+// whose execution lands on the vsync grid, so scripts observing
+// System.getTickCount see strictly uniform frame steps. In the browser, RAF
+// timestamps jitter 1-2ms against the grid and callback dispatch adds more
+// jitter; reading the raw clock per frame leaks that into the integer-ms
+// gates used by game scripts (missed beats / re-anchoring drift). The PLL
+// below re-anchors each frame's observable tick onto a smoothed vsync grid
+// driven by the RAF timestamp captured through __tvpRafT (installed by patch
+// 0082's main-loop wrapper). The tick value is frozen for the whole frame
+// (single thread means no RAF can fire mid-frame). When RAF is stalled
+// (modal spin loop / hidden tab) for over 50ms, or before the first frame,
+// callers get the raw clock; non-main threads keep the raw clock as well.
+// This build's clock domain is page-relative milliseconds
+// (emscripten_get_now / RAF timestamps), so unlike kirikiroid2-web no
+// timeOrigin conversion is needed here.
+//---------------------------------------------------------------------------
+#ifdef __EMSCRIPTEN__
+static double TVPWebSnapTick = -1; // current frame's locked tick (main thread only)
+static double TVPWebSnapPeriod = 0; // locked grid spacing estimate in ms
+static double TVPWebSnapUpdRaw = -1; // raw clock at last PLL update (stall detection)
+static double TVPWebLastRafT = -1; // previous frame's RAF timestamp
+static tjs_uint32 TVPWebMainLastTick = 0; // monotonic guard for the main thread
+
+// double -> tjs_uint32 must go through uint64: wasm trunc_sat saturates
+// out-of-range doubles to 0xFFFFFFFF while the engine semantics are a
+// mod-2^32 wraparound (the original integer arithmetic behavior).
+static inline tjs_uint32 TVPWebMSToTick32(double ms)
+{
+	return static_cast<tjs_uint32>(static_cast<tjs_uint64>(ms));
+}
+#endif // __EMSCRIPTEN__
+
+//---------------------------------------------------------------------------
 // TVPGetRoughTickCount
 // 32bit値のtickカウントを得る
 //---------------------------------------------------------------------------
 tjs_uint32 TVPGetRoughTickCount32()
 {
+#if defined(TVP_COMPILING_KRKRSDL2) && defined(__EMSCRIPTEN__)
+	if( TVPWEB_IS_MAIN_THREAD() )
+	{
+		tjs_uint32 r;
+		double raw = emscripten_get_now();
+		if( TVPWebSnapTick >= 0 && raw - TVPWebSnapUpdRaw <= 50.0 )
+		{
+			r = TVPWebMSToTick32( TVPWebSnapTick );
+		}
+		else
+		{
+			// startup / RAF stalled: raw clock
+			r = TVPWebMSToTick32( raw );
+		}
+		// The locked and raw domains differ by a few ms; clamp on domain
+		// switches so the main thread stays monotonic. A fallback of 2^31
+		// or more is a true mod-2^32 wrap and passes through.
+		if( r < TVPWebMainLastTick && ( TVPWebMainLastTick - r ) < 0x80000000UL )
+			r = TVPWebMainLastTick;
+		TVPWebMainLastTick = r;
+		return r;
+	}
+	return TVPWebMSToTick32( emscripten_get_now() );
+#else
 #ifdef TVP_COMPILING_KRKRSDL2
 	return SDL_GetTicks();
 #else
