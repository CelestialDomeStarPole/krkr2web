+static bool Krkr2WebAutoPathListEqualsSnapshot()
+{
+	if (TVPAutoPathList.size() != Krkr2WebAutoPathListSnapshot.size()) return false;
+	for (size_t i = 0; i < TVPAutoPathList.size(); ++i)
+		if (TVPAutoPathList[i] != Krkr2WebAutoPathListSnapshot[i]) return false;
+	return true;
+}
+#endif
