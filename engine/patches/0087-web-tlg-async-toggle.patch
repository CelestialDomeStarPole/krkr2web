@@ -1534,7 +1534,19 @@
 		TVPGraphicCacheSystemLimit = 160 * 1024 * 1024;
 	if(TVPGetGraphicCacheLimit() == 0)
 		TVPSetGraphicCacheLimit(TVPGraphicCacheSystemLimit);
-	TVPAddImportantLog(ttstr(TJS_W("KRKR2WEB_D5_GRAPHIC_CACHE ")) +
+extern void Krkr2WebSetTlgAsyncEnabled(bool);
+	{
+		tTJSVariant tlgOpt;
+		if (TVPGetCommandLine(TJS_W("-tlgasync"), &tlgOpt)) {
+			ttstr tv(tlgOpt);
+			bool on = (tv == TJS_W("1") || tv == TJS_W("on") || tv == TJS_W("true") || tv == TJS_W("yes"));
+			Krkr2WebSetTlgAsyncEnabled(on);
+			TVPAddImportantLog(ttstr(TJS_W("KRKR2WEB_D5_TLG_ASYNC ")) + ttstr(on ? TJS_W("on") : TJS_W("off")));
+		} else {
+			Krkr2WebSetTlgAsyncEnabled(false);
+		}
+	}
+		TVPAddImportantLog(ttstr(TJS_W("KRKR2WEB_D5_GRAPHIC_CACHE ")) +
 		ttstr((tjs_int)(TVPGraphicCacheSystemLimit / (1024 * 1024))));
