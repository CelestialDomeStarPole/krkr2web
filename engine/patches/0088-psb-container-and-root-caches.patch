# krkr2web: PSB load/materialization cost fixes (patch 0088).
#
# Evidence (throttled new-game trace, rate=6, build before this patch):
# the 35s scene-load tick was 74% PSBFile.root materialization of the
# 2.5MB scenario .scn - read TWICE on one instance (label scan + execution,
# 13.2s + 14.9s). psb:// subimage opens also forced full PSB container
# re-parses because PSBMedia kept exactly one container.
#
# - PSBFile: cache the materialized script root per instance (.root now
#   materializes once per load; cleared whenever the owner contents are
#   replaced). Per-materialization name/string memo tables cut redundant
#   UTF-8->TJS re-decodes (451,769 nodes share 1,478 distinct keys).
# - PSBMedia: six-slot MRU container cache instead of one, so interleaved
#   window/chapter/voicebar/quickmenu subimage reads stop re-parsing whole
#   containers.
# - Telemetry: KRKR2WEB_D5_PSB_LOAD per container load, KRKR2WEB_D5_PSB_MAT
#   for materializations >=20ms (with node count).
diff --git a/external/krkrz/plugin/psbfile/PSBFile.cpp b/external/krkrz/plugin/psbfile/PSBFile.cpp
index a05a646..32b4dcc 100644
--- a/external/krkrz/plugin/psbfile/PSBFile.cpp
+++ b/external/krkrz/plugin/psbfile/PSBFile.cpp
@@ -3,8 +3,11 @@
 #include <cstring>
