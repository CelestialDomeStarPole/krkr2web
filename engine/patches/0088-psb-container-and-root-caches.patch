 #include "PSBMediaRegistry.h"
 #include "PSBDispatch.h"
 #include "PSBPackedInternal.h"
@@ -32,8 +35,20 @@ namespace PSB {
             return ttstr(value);
         }
 
+        // krkr2web: per-materialization memo tables. A scenario PSB holds
+        // hundreds of thousands of dictionary entries that reuse a few
+        // thousand distinct names and strings; re-decoding and re-allocating
+        // per occurrence dominated the materialization wall time.
+        struct MaterializeContext {
+            std::vector<ttstr> names;
+            std::unordered_map<const char *, tTJSVariant> strings;
+            std::uint64_t nodes = 0;
+        };
+
         tTJSVariant materializeScriptValue(const PSBFile &file,
-                                            const std::uint8_t *node) {
+                                            const std::uint8_t *node,
+                                            MaterializeContext &context) {
+            ++context.nodes;
             switch(detail::GetTypeCategory_guess(node[0])) {
                 case 0:
                     return tTJSVariant();
@@ -53,8 +68,16 @@ namespace PSB {
                 case 4: {
                     const PSBRawNode value(file, node);
                     const char *text = value.GetString();
-                    return text ? tTJSVariant(utf8ToTjs(text))
-                                : tTJSVariant();
+                    if(text == nullptr) {
+                        return tTJSVariant();
+                    }
+                    const auto memo = context.strings.find(text);
+                    if(memo != context.strings.end()) {
+                        return memo->second;
+                    }
+                    tTJSVariant decoded(utf8ToTjs(text));
+                    context.strings.emplace(text, decoded);
+                    return decoded;
                 }
                 case 5: {
                     const PSBRawNode value(file, node);
@@ -72,7 +95,7 @@ namespace PSB {
                         for(std::uint32_t index = 0;
                             index < offsets.nElementCount; ++index) {
                             tTJSVariant value = materializeScriptValue(
-                                file, values + offsets[index]);
+                                file, values + offsets[index], context);
                             array->PropSetByNum(
                                 TJS_MEMBERENSURE,
                                 static_cast<tjs_int>(index), &value, array);
@@ -94,14 +117,21 @@ namespace PSB {
                             packed + keys.nBytes);
                         const std::uint8_t *values = packed + keys.nBytes +
                             offsets.nBytes;
-                        std::string key;
                         for(std::uint32_t index = 0;
                             index < keys.nElementCount; ++index) {
-                            detail::DecodeName_guess(
-                                key, file.GetOwner(), keys[index]);
-                            const ttstr member = utf8ToTjs(key);
+                            ttstr member;
+                            if(context.names.size() <= keys[index]) {
+                                context.names.resize(keys[index] + 1);
+                            }
+                            if(context.names[keys[index]].IsEmpty()) {
+                                std::string key;
+                                detail::DecodeName_guess(
+                                    key, file.GetOwner(), keys[index]);
+                                context.names[keys[index]] = utf8ToTjs(key);
+                            }
+                            member = context.names[keys[index]];
                             tTJSVariant value = materializeScriptValue(
-                                file, values + offsets[index]);
+                                file, values + offsets[index], context);
                             dictionary->PropSet(
                                 TJS_MEMBERENSURE, member.c_str(), nullptr,
                                 &value, dictionary);
@@ -789,17 +819,37 @@ namespace PSB {
     }
 
     iTJSDispatch2 *PSBFile::GetScriptRootDispatch() const {
+        // krkr2web: serve the cached materialization when .root is read
+        // again on the same contents. The scenario loader reads .root twice
+        // per PSB (label scan + execution); each full materialization of a
+        // 2.5MB scenario PSB costs 2+ seconds on the target WebView.
+        if(scriptRootDispatch_ != nullptr) {
+            scriptRootDispatch_->AddRef();
+            return scriptRootDispatch_;
+        }
         PSBRawOwner *owner = GetOwner();
         if(owner == nullptr) {
             return nullptr;
         }
+        const tjs_uint64 krkr2webMatT0 = TVPGetTickCount();
+        MaterializeContext context;
         tTJSVariant root = materializeScriptValue(
-            *this, owner->GetHeader()->entries);
+            *this, owner->GetHeader()->entries, context);
+        {
+            const tjs_uint krkr2webMatMs =
+                static_cast<tjs_uint>(TVPGetTickCount() - krkr2webMatT0);
+            if(krkr2webMatMs >= 20)
+                TVPAddImportantLog(ttstr(TJS_W("KRKR2WEB_D5_PSB_MAT ms=")) +
+                    ttstr((tjs_int)krkr2webMatMs) + TJS_W(" nodes=") +
+                    ttstr((tjs_int)context.nodes));
+        }
         if(root.Type() != tvtObject || !root.AsObjectNoAddRef()) {
             return nullptr;
         }
         iTJSDispatch2 *dispatch = root.AsObjectNoAddRef();
         dispatch->AddRef();
+        scriptRootDispatch_ = dispatch;
+        scriptRootDispatch_->AddRef();
         return dispatch;
     }
 } // namespace PSB
