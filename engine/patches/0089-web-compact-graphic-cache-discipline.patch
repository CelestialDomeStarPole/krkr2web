+namespace {
+    // krkr2web: emergency compacts (allocation-failure retries, level >=
+    // MINIMIZE) free the materialized .root trees pinned by the 0088 root
+    // cache; near the 1GiB heap ceiling those pins are hundreds of MB and
+    // keep the engine in the re-allocate/re-fail loop behind the title
+    // freeze. Normal doCompact calls are clamped below this level on the
+    // web (SystemIntf.cpp), so this only fires on real pressure.
+    class Krkr2WebPSBRootCompactCallback : public tTVPCompactEventCallbackIntf {
+    public:
+        void TJS_INTF_METHOD OnCompact(tjs_int level) override {
+            if(level < TVP_COMPACT_LEVEL_MINIMIZE) return;
+            const tjs_uint released = PSB::PSBFile::Krkr2WebCompactReleaseRoots();
+            if(released > 0)
+                TVPAddImportantLog(ttstr(TJS_W("KRKR2WEB_D5_PSB_ROOT_RELEASE n=")) +
+                    ttstr((tjs_int)released));
+        }
+    };
+} // namespace
 
 void initPsbFile() {
     // Every reference guard-initializes the function-local pointer once, while
     // still registering the same media object on every invocation.
     static PSB::PSBMedia *psbMedia = new PSB::PSBMedia();
     TVPRegisterStorageMedia(psbMedia);
+    static Krkr2WebPSBRootCompactCallback krkr2webCompactCallback;
+    TVPAddCompactEventHook(&krkr2webCompactCallback);
