+// krkr2web (patch 0091): the poll loop below is the engine's only remaining
+// untraced, timeout-less Asyncify suspension. A dialog the player never
+// sees or answers freezes the main loop one 100ms sleep at a time - the
+// title-rebuild wedge on device showed 40s+ of total silence with no
+// pending-op hint. Publish the shared async trace for the whole wait so the
+// player's stall detector can name it, and log ask/answer to the engine
+// record. stdout printf reaches Module.print like every other KRKR2WEB tag.
+static void Krkr2WebLogDialogEvent(const char *tag, const char *text,
+	const char *caption, tjs_int flags, tjs_int answer)
+{
+	std::string t(text ? text : ""), c(caption ? caption : "");
+	for(auto &ch : t) if((unsigned char)ch < 0x20) ch = ' ';
+	for(auto &ch : c) if((unsigned char)ch < 0x20) ch = ' ';
+	if(t.size() > 80) t = t.substr(0, 80) + "...";
+	if(c.size() > 40) c = c.substr(0, 40) + "...";
+	printf("KRKR2WEB_D5_%s flags=%d caption='%s' text='%s' answer=%d\n",
+		tag, (int)flags, c.c_str(), t.c_str(), (int)answer);
+	fflush(stdout);
+}
